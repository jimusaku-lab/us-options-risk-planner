# Saxo API Read-only local API settings
# Copy this file to .env.local on each user's Mac and fill in their own LIVE AppKey.

SAXO_CLIENT_ID=
SAXO_ENVIRONMENT=live
SAXO_REDIRECT_URI=http://localhost:18787/api/saxo/auth/callback

# GitHub Pages版から、各自のMac上のローカルAPIへ接続する場合の推奨値。
SAXO_LOCAL_UI_ALLOWED_ORIGIN=https://jimusaku-lab.github.io
SAXO_LOCAL_UI_RETURN_URL=https://jimusaku-lab.github.io/us-options-risk-planner/

# Local API stays on 127.0.0.1 and must not be exposed to the network.
SAXO_LOCAL_API_PORT=18787
